# Node install tree — this repository is also an installable bundle
# (`dsh plugin add` installs it into a PROFILE, but a contributor may run
# npm/pnpm install here; nothing in that tree belongs in the package).
node_modules/

# Python bytecode caches (engines + standalone scripts)
__pycache__/
*.py[cod]

# Machine-local path overrides — do NOT commit. `env.sh` is generated (from
# env.sh.example) by setup.sh or by hand; `.dshenv` is the plugin-readable form.
env.sh
.dshenv

# Output artifacts from reference runs
*.mp4
*.png

# Per-workspace taste data the loop accumulates: the creator's group log and the
# identity GGUF bound to this workspace's style-brain. An identity you intend to
# share belongs somewhere you choose explicitly — *.gguf is NOT mass-ignored.
.editapart/
