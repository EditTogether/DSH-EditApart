# Portable env template for the EditApart preset (copy to env.sh, or run setup.sh
# which writes env.sh for you).
#
# The plugin and engines resolve toolchains env-first (DSH_*), then PATH, then a
# bare name. `scenedetect` and ImageMagick are frequently installed in a venv
# that is NOT on PATH, so a machine needs these set once. Do either:
#
#    cp env.sh.example env.sh && source ./env.sh
#    # or, to have setup.sh write env.sh against your venv:
#    bash setup.sh && source ./env.sh
#
# `env.sh` is machine-local and gitignored — do not commit it.
#
# Overridable keys:
#   DSH_EDIT_PY        Python interpreter running bin/edit_apart_core.py / photo_core.py
#   DSH_SCENEDETECT    scenedetect CLI (shot detection)
#   DSH_FFMPEG         ffmpeg binary
#   DSH_FFPROBE        ffprobe binary
#   DSH_IMAGEMAGICK    ImageMagick `magick` binary (photo renderer)
#
# If a tool is on PATH you can leave its variable unset and it will be found.
# The code never hardcodes an absolute path — this file is the one place a
# machine's local paths live.

# --- per-machine local paths (edit these; defaults assume ~/dsh-edit-venv) ---
export DSH_EDIT_PY="${DSH_EDIT_PY:-$HOME/dsh-edit-venv/bin/python}"
export DSH_SCENEDETECT="${DSH_SCENEDETECT:-$HOME/dsh-edit-venv/bin/scenedetect}"
# export DSH_IMAGEMAGICK="${DSH_IMAGEMAGICK:-/usr/bin/magick}"
# export DSH_FFMPEG="${DSH_FFMPEG:-ffmpeg}"
# export DSH_FFPROBE="${DSH_FFPROBE:-ffprobe}"

echo "EditApart env:"
echo "  DSH_EDIT_PY=$DSH_EDIT_PY"
echo "  DSH_SCENEDETECT=$DSH_SCENEDETECT"
